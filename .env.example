# ============================================================
# Credit Risk Intelligence Platform
# Environment Configuration
# ============================================================

# ------------------------------------------------------------
# LLM / Talk-to-Data
# ------------------------------------------------------------

LLM_PROVIDER=gemini

# Add your Gemini API key here for local/Docker deployment.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash

# LLM generation settings
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.0

# Cache repeated Talk-to-Data questions.
LLM_ENABLE_CACHE=true


# ------------------------------------------------------------
# Data
# ------------------------------------------------------------

# The assignment uses the real Home Credit dataset.
USE_SYNTHETIC_FALLBACK=false

# Only used if synthetic fallback is explicitly enabled.
SYNTHETIC_ROWS=15000
SYNTHETIC_SEED=42

TEST_SIZE=0.20
VAL_SIZE=0.15
RANDOM_STATE=42


# ------------------------------------------------------------
# Machine Learning
# ------------------------------------------------------------

CV_FOLDS=5

EARLY_STOPPING_ROUNDS=100
NUM_BOOST_ROUND=2000
LEARNING_RATE=0.03

# Cost of a false negative relative to a false positive.
FN_COST_RATIO=8.0

# Risk-band thresholds
LOW_RISK_BAND_MAX=0.30
MEDIUM_RISK_BAND_MAX=0.65


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Default local database.
DATABASE_URL=sqlite:///data/credit_risk.db

# Maximum number of rows returned by Talk-to-Data queries.
QUERY_ROW_LIMIT=500


# ------------------------------------------------------------
# Application / Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO